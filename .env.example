# Copy this file to .env and edit the values.

# Port the API listens on
PORT=3000

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# How long a login token stays valid (e.g. 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# SQLite database file (created automatically). Use :memory: for throwaway tests.
DB_FILE=./data/taskmaster.db

# Folder where uploaded attachments are stored
UPLOAD_DIR=./uploads

# Max attachment size in MB
MAX_UPLOAD_MB=5

# OPTIONAL - enables the AI task-description endpoint (POST /api/ai/describe).
# Leave blank to use the built-in template instead.
ANTHROPIC_API_KEY=
